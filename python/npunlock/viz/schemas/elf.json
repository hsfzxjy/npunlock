  "lookups": {
    "section_descriptions": {
      ".text": "Linked executable code in the standalone SHAVE ELF.",
      ".symtab": "ELF symbol table used to name sections and relocation targets.",
      ".strtab": "Null-terminated strings used by the ELF symbol table.",
      ".shstrtab": "Null-terminated names for ELF sections."
    },
    "section_type_descriptions": {
      "4": "ELF64 relocation entries with explicit addends; links identify their target records and sections.",
      "8": "An ELF NOBITS section: it has a logical size but occupies no payload bytes in the file."
    },
    "defaults": {
      "section_description": "An ELF section header and, when present, its file-backed payload. No additional format meaning is inferred."
    }
  },
  "rules": {
    "section_categories": [
      { "value": "code", "equals": [".text"] },
      { "value": "reference", "prefixes": [".rlt", ".rela", ".rel"] },
      { "value": "reference", "contains": ["symtab"] },
      { "value": "metadata", "contains": ["strtab", "note"] }
    ]
  }
}
