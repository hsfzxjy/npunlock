        },
        { "id": "data_encoding", "offset": 5, "size": 1, "encoding": "u8", "value_map": { "1": "little-endian", "2": "big-endian" }, "description": "Byte order used by multibyte ELF fields.", "confidence": "confirmed" },
        { "id": "ident_version", "offset": 6, "size": 1, "encoding": "u8", "description": "ELF identification version.", "confidence": "confirmed" },
        { "id": "os_abi", "offset": 7, "size": 1, "encoding": "u8", "description": "ELF operating-system ABI identifier.", "confidence": "confirmed" },
