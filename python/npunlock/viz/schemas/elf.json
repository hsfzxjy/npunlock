{
  "format": "npunlock.viz-schema",
  "version": 1,
  "id": "elf-little-endian-v1",
  "nodes": {
    "elf_image": {
      "kind": "ELF image",
      "category": "unknown",
      "description": "Complete little-endian ELF container. Child regions explain its header, sections, and known relationships."
    },
    "elf_header": {
      "kind": "header",
      "category": "metadata",
      "description": "Standard ELF identification and table-location fields for this binary artifact."
    },
    "section_table": {
      "kind": "table",
      "category": "metadata",
      "description": "Contiguous standard ELF section headers. Each child also links its file-backed payload when present."
    },
    "section": {
      "kind": "section",
      "category": "unknown",
      "description": "An ELF section header and, when present, its file-backed payload. No additional format meaning is inferred."
    },
    "symbol": {
      "kind": "ELF symbol",
      "category": "reference",
      "description": "One ELF symbol-table entry. Relocations use its table index to identify a section or named target."
    }
  },
  "records": {
    "elf32_header": {
      "size": 52,
      "fields": [
        {
          "id": "magic",
          "offset": 0,
          "size": 4,
          "encoding": "bytes-hex",
          "description": "ELF identification bytes 0x7f, E, L, F.",
          "confidence": "confirmed"
        },
        {
          "id": "class",
          "offset": 4,
          "size": 1,
          "encoding": "u8",
          "value_map": { "1": "ELF32", "2": "ELF64" },
          "description": "ELF word size: 32-bit for standalone SHAVE kernels or 64-bit for native graphs.",
          "confidence": "confirmed"
        },
        { "id": "data_encoding", "offset": 5, "size": 1, "encoding": "u8", "value_map": { "1": "little-endian", "2": "big-endian" }, "description": "Byte order used by multibyte ELF fields.", "confidence": "confirmed" },
        { "id": "ident_version", "offset": 6, "size": 1, "encoding": "u8", "description": "ELF identification version.", "confidence": "confirmed" },
        { "id": "os_abi", "offset": 7, "size": 1, "encoding": "u8", "description": "ELF operating-system ABI identifier.", "confidence": "confirmed" },
        { "id": "abi_version", "offset": 8, "size": 1, "encoding": "u8", "description": "Version of the selected operating-system ABI.", "confidence": "confirmed" },
        { "id": "ident_padding", "offset": 9, "size": 7, "encoding": "bytes-hex", "description": "Reserved ELF identification bytes.", "confidence": "confirmed" },
        {
          "id": "type",
          "offset": 16,
          "size": 2,
          "encoding": "u16le",
          "description": "Standard ELF object-file type.",
          "confidence": "confirmed"
        },
        { "id": "version", "offset": 20, "size": 4, "encoding": "u32le", "description": "ELF file-format version.", "confidence": "confirmed" },
        {
          "id": "machine",
          "offset": 18,
          "size": 2,
          "encoding": "u16le",
          "description": "Standard ELF target-machine identifier.",
          "confidence": "confirmed"
        },
        { "id": "program_table", "offset": 28, "size": 4, "encoding": "u32le", "display": "hex", "description": "File offset of the program-header table; zero for a section-only image.", "confidence": "confirmed" },
        {
          "id": "entry",
          "offset": 24,
          "size": 4,
          "encoding": "u32le",
          "display": "hex",
          "description": "Virtual entry address recorded by the ELF header.",
          "confidence": "confirmed"
        },
        { "id": "flags", "offset": 36, "size": 4, "encoding": "u32le", "display": "hex", "description": "Processor-specific ELF flags.", "confidence": "confirmed" },
        { "id": "header_size", "offset": 40, "size": 2, "encoding": "u16le", "description": "Size of this ELF header in bytes.", "confidence": "confirmed" },
        { "id": "program_entry_size", "offset": 42, "size": 2, "encoding": "u16le", "description": "Size of one program-header entry in bytes.", "confidence": "confirmed" },
        { "id": "program_count", "offset": 44, "size": 2, "encoding": "u16le", "description": "Number of program-header entries.", "confidence": "confirmed" },
        { "id": "section_entry_size", "offset": 46, "size": 2, "encoding": "u16le", "description": "Size of one section-header entry in bytes.", "confidence": "confirmed" },
        {
          "id": "section_table",
          "offset": 32,
          "size": 4,
          "encoding": "u32le",
          "display": "hex",
          "description": "File offset of the ELF section-header table.",
          "confidence": "confirmed"
        },
        {
          "id": "section_count",
          "offset": 48,
          "size": 2,
          "encoding": "u16le",
          "description": "Number of entries in the ELF section-header table.",
          "confidence": "confirmed"
        },
        { "id": "section_name_index", "offset": 50, "size": 2, "encoding": "u16le", "description": "Section index of the section-name string table.", "confidence": "confirmed" }
      ]
    },
    "elf64_header": {
      "size": 64,
      "fields": [
        {
          "id": "magic",
          "offset": 0,
          "size": 4,
          "encoding": "bytes-hex",
