        { "id": "header_size", "offset": 52, "size": 2, "encoding": "u16le", "description": "Size of this ELF header in bytes.", "confidence": "confirmed" },
        { "id": "program_entry_size", "offset": 54, "size": 2, "encoding": "u16le", "description": "Size of one program-header entry in bytes.", "confidence": "confirmed" },
        { "id": "program_count", "offset": 56, "size": 2, "encoding": "u16le", "description": "Number of program-header entries.", "confidence": "confirmed" },
        { "id": "section_entry_size", "offset": 58, "size": 2, "encoding": "u16le", "description": "Size of one section-header entry in bytes.", "confidence": "confirmed" },
        {
