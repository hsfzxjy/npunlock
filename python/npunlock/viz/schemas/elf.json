          "id": "type",
          "offset": 16,
          "size": 2,
          "encoding": "u16le",
          "description": "Standard ELF object-file type.",
          "confidence": "confirmed"
        },
        { "id": "version", "offset": 20, "size": 4, "encoding": "u32le", "description": "ELF file-format version.", "confidence": "confirmed" },
        {
          "id": "machine",
          "offset": 18,
          "size": 2,
          "encoding": "u16le",
          "description": "Standard ELF target-machine identifier.",
