      ]
    },
    "elf32_section_header": {
      "size": 40,
      "fields": [
        { "id": "index", "computed": true, "description": "Zero-based position in the section-header table.", "confidence": "confirmed" },
        { "id": "name_offset", "offset": 0, "size": 4, "encoding": "u32le", "display": "hex", "description": "Byte offset of this section's name in the section-name string table.", "confidence": "confirmed" },
        { "id": "type", "offset": 4, "size": 4, "encoding": "u32le", "description": "Standard ELF section type.", "confidence": "confirmed" },
        { "id": "flags", "offset": 8, "size": 4, "encoding": "u32le", "display": "hex", "description": "ELF section attribute flags.", "confidence": "confirmed" },
        { "id": "virtual_address", "offset": 12, "size": 4, "encoding": "u32le", "display": "hex", "description": "Virtual address assigned to the section, or zero when it is not mapped.", "confidence": "confirmed" },
        { "id": "file_offset", "offset": 16, "size": 4, "encoding": "u32le", "display": "hex", "description": "File-relative start of the section payload.", "confidence": "confirmed" },
        { "id": "size", "offset": 20, "size": 4, "encoding": "u32le", "display": "hex", "description": "Section payload size in bytes, or logical size for NOBITS sections.", "confidence": "confirmed" },
        { "id": "link", "offset": 24, "size": 4, "encoding": "u32le", "description": "Section index whose standard ELF role depends on this section type.", "confidence": "confirmed" },
        { "id": "info", "offset": 28, "size": 4, "encoding": "u32le", "description": "Additional standard ELF metadata whose role depends on this section type.", "confidence": "confirmed" },
        { "id": "alignment", "offset": 32, "size": 4, "encoding": "u32le", "display": "hex", "description": "Required section alignment in bytes.", "confidence": "confirmed" },
